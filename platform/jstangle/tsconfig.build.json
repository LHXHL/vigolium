{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    // @codemod/matchers still depends on @babel/types 7; point its typings at
    // our Babel 8 copy so matchers and AST nodes share one type universe.
    "paths": { "@babel/types": ["./node_modules/@babel/types"] },
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"],
  "exclude": ["**/test"]
}
