{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.scanETAView": {
      "properties": {
        "estimate_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper_bound_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "estimate_ms",
        "upper_bound_ms",
        "basis"
      ]
    },
    "cli.scanLivenessView": {
      "properties": {
        "last_write_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_gone": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "last_write_at",
        "stale",
        "sources"
      ]
    },
    "cli.scanProgressView": {
      "properties": {
        "done": {
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "done",
        "total",
        "unit"
      ]
    },
    "cli.scanStatusView": {
      "properties": {
        "scan_uuid": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "effective_status": {
          "type": "string"
        },
        "liveness": {
          "$ref": "#/$defs/cli.scanLivenessView"
        },
        "phase": {
          "type": "string"
        },
        "phase_started_at": {
          "type": "string"
        },
        "phases_done": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "phases_planned": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requests_sent": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "findings_by_severity": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/cli.scanProgressView"
            },
            {
              "type": "null"
            }
          ]
        },
        "eta": {
          "$ref": "#/$defs/cli.scanETAView"
        },
        "completeness": {
          "type": "string"
        },
        "stop_reason": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer"
        },
        "pid": {
          "type": "integer"
        },
        "runner_host": {
          "type": "string"
        },
        "project_uuid": {
          "type": "string"
        },
        "db_path": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scan_uuid",
        "status",
        "effective_status",
        "liveness",
        "phases_done",
        "requests_sent",
        "findings",
        "findings_by_severity",
        "progress",
        "eta",
        "started_at",
        "duration_ms",
        "source"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "scan wait"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.scanStatusView"
      },
      "type": "array",
      "maxItems": 1,
      "minItems": 1,
      "description": "Exactly one object: the command's single result."
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium scan wait -j",
  "description": "The scan's final status view, printed once the scan ends."
}
