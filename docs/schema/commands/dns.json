{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    },
    "dnsresolve.Answer": {
      "properties": {
        "name": {
          "type": "string"
        },
        "resolver": {
          "type": "string"
        },
        "a": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "aaaa": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cname": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mx": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "txt": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "soa": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "caa": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "records": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/dnsresolve.Record"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "rcode": {
          "type": "string"
        },
        "errors": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "resolver",
        "records",
        "rcode"
      ]
    },
    "dnsresolve.Record": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "ttl": {
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type",
        "ttl",
        "value"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "dns"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/dnsresolve.Answer"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "stored": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "stored",
    "kind"
  ],
  "title": "vigolium dns -j",
  "description": "One answer per name: every record type asked for, each record with its TTL, and how many answers were stored."
}
