{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.storageColumn": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "nullable": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "json_field": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type",
        "nullable"
      ]
    },
    "cli.storageTable": {
      "properties": {
        "table": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "rows": {
          "type": "integer"
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/cli.storageColumn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "table",
        "rows",
        "columns"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "schema storage"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.storageTable"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind"
  ],
  "title": "vigolium schema storage -j",
  "description": "The database's tables with columns, row counts, purpose, and the -j field a column surfaces as."
}
