{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "import"
    },
    "kind": {
      "type": "string",
      "const": "mutation"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "changed": {
      "type": "boolean"
    },
    "action": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "agentic_scan_uuid": {
      "type": "string"
    },
    "records_imported": {
      "type": "integer"
    },
    "records_skipped_duplicate": {
      "type": "integer"
    },
    "findings_total": {
      "type": "integer"
    },
    "findings_saved": {
      "type": "integer"
    },
    "findings_skipped": {
      "type": "integer"
    },
    "findings_failed": {
      "type": "integer"
    },
    "severity": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "parse_errors": {
      "type": "integer"
    },
    "session_dir": {
      "type": "string"
    },
    "storage_url": {
      "type": "string"
    },
    "merged_from": {
      "type": "string"
    },
    "records_merged": {
      "type": "integer"
    },
    "findings_merged": {
      "type": "integer"
    },
    "findings_deduped": {
      "type": "integer"
    },
    "scans_merged": {
      "type": "integer"
    },
    "agentic_scans_merged": {
      "type": "integer"
    },
    "projects_merged": {
      "type": "integer"
    },
    "finding_records_merged": {
      "type": "integer"
    },
    "oast_merged": {
      "type": "integer"
    },
    "report_path": {
      "type": "string"
    },
    "uploaded_to": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "bridge_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "matched": {
      "type": "integer"
    },
    "selected": {
      "type": "integer"
    },
    "inserted": {
      "type": "integer"
    },
    "updated": {
      "type": "integer"
    },
    "unchanged": {
      "type": "integer"
    },
    "skipped": {
      "type": "integer"
    },
    "oversized": {
      "type": "integer"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind",
    "changed",
    "action"
  ],
  "title": "vigolium import -j",
  "description": "items is always []; the import counters stay at the top level (a parse, a SQLite merge, or a live bridge import)."
}
