{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.extRunResult": {
      "properties": {
        "module_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "matched": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "param": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "extracted": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "request": {
          "type": "string"
        },
        "response": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "module_id",
        "name",
        "severity",
        "confidence"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    },
    "exttest.CallError": {
      "properties": {
        "handler": {
          "type": "string"
        },
        "insertion": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "handler",
        "message"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "extensions run"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.extRunResult"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "module_id": {
      "type": "string"
    },
    "record_uuid": {
      "type": "string"
    },
    "handler": {
      "type": "string"
    },
    "handlers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "calls": {
      "type": "integer"
    },
    "errors": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/exttest.CallError"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "network_allowed": {
      "type": "boolean"
    },
    "network_calls_blocked": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "module_id",
    "record_uuid",
    "handler",
    "handlers",
    "calls",
    "errors",
    "network_allowed",
    "network_calls_blocked",
    "duration_ms",
    "kind"
  ],
  "title": "vigolium extensions run -j",
  "description": "What one extension reported for one stored record (ext run, ext eval --record-uuid): items are its results; errors are the handler calls that threw; network_calls_blocked counts the requests an offline run refused. ok is false when a handler threw (exit 1)."
}
