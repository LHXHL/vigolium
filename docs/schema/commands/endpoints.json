{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    },
    "database.EndpointAuth": {
      "properties": {
        "authenticated": {
          "type": "integer"
        },
        "anonymous": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "authenticated",
        "anonymous"
      ]
    },
    "database.EndpointView": {
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "methods": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "records": {
          "type": "integer"
        },
        "distinct_paths": {
          "type": "integer"
        },
        "distinct_paths_capped": {
          "type": "boolean"
        },
        "sample_paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "params": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "param_count": {
          "type": "integer"
        },
        "request_content_types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_content_types": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_status": {
          "type": "integer"
        },
        "auth": {
          "$ref": "#/$defs/database.EndpointAuth"
        },
        "sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "js_outcomes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "findings": {
          "type": "integer"
        },
        "findings_by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "max_severity": {
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "last_seen": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "origin",
        "host",
        "template",
        "methods",
        "records",
        "distinct_paths",
        "sample_paths",
        "params",
        "param_count",
        "request_content_types",
        "response_content_types",
        "status",
        "top_status",
        "auth",
        "sources",
        "findings",
        "first_seen",
        "last_seen"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "endpoints"
    },
    "kind": {
      "type": "string",
      "const": "read"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/database.EndpointView"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "provenance_warning": {
      "type": "string"
    },
    "provenance_detail": {
      "type": "string"
    },
    "records_scanned": {
      "type": "integer"
    },
    "capped": {
      "type": "boolean"
    },
    "unbucketed_records": {
      "type": "integer"
    },
    "collapse": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "records_scanned",
    "capped",
    "unbucketed_records",
    "kind"
  ],
  "title": "vigolium endpoints -j",
  "description": "Endpoints (origin + path template) aggregated from stored traffic."
}
