{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "cli.ingestedRecord": {
      "properties": {
        "uuid": {
          "type": "string"
        },
        "uuid_short": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status_code": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "uuid",
        "uuid_short",
        "method",
        "url",
        "status_code"
      ]
    },
    "contract.GlobSkipped": {
      "properties": {
        "file": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "error"
      ]
    },
    "contract.GlobSources": {
      "properties": {
        "pattern": {
          "type": "string"
        },
        "matched": {
          "type": "integer"
        },
        "loaded": {
          "type": "integer"
        },
        "skipped": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/contract.GlobSkipped"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "parse_errors": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pattern",
        "matched",
        "loaded",
        "skipped",
        "parse_errors"
      ]
    },
    "contract.OutputBudget": {
      "properties": {
        "max_bytes": {
          "type": "integer"
        },
        "returned": {
          "type": "integer"
        },
        "omitted": {
          "type": "integer"
        },
        "next_offset": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "max_bytes",
        "returned",
        "omitted",
        "next_offset"
      ]
    },
    "core.DropSample": {
      "properties": {
        "url": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url",
        "reason"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "command": {
      "type": "string",
      "const": "ingest"
    },
    "kind": {
      "type": "string",
      "const": "mutation"
    },
    "ok": {
      "type": "boolean",
      "const": true
    },
    "changed": {
      "type": "boolean"
    },
    "action": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "project_uuid": {
      "type": "string"
    },
    "db_path": {
      "type": "string"
    },
    "total": {
      "type": "integer"
    },
    "offset": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/cli.ingestedRecord"
      },
      "type": "array"
    },
    "query": {
      "type": "string"
    },
    "query_argv": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "generated_at_ms": {
      "type": "integer"
    },
    "project_source": {
      "type": "string",
      "enum": [
        "flag",
        "env",
        "active_file",
        "default"
      ]
    },
    "project_scoped": {
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "glob_sources": {
      "$ref": "#/$defs/contract.GlobSources"
    },
    "output_budget": {
      "$ref": "#/$defs/contract.OutputBudget"
    },
    "records_ingested": {
      "type": "integer"
    },
    "records_failed": {
      "type": "integer"
    },
    "records_skipped": {
      "type": "integer"
    },
    "records_submitted": {
      "type": "integer"
    },
    "errors": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "integer"
    },
    "input_format": {
      "type": "string"
    },
    "record_source": {
      "type": "string"
    },
    "items_truncated": {
      "type": "boolean"
    },
    "failure_reasons": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/core.DropSample"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "total",
    "offset",
    "limit",
    "items",
    "project_source",
    "kind",
    "changed",
    "action"
  ],
  "title": "vigolium ingest -j",
  "description": "The records the ingest left in the store (capped; items_truncated says more exist), with why any were not stored."
}
